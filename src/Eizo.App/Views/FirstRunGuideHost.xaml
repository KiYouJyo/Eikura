<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="Eizo.Views.FirstRunGuideHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:Eizo.Views"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch"
             IsTabStop="True"
             KeyDown="OnKeyDown"
             SizeChanged="OnSizeChanged">
  <Grid x:Name="OverlayRoot"
        Background="{ThemeResource ShellNavigationPaneBackgroundBrush}"
        Padding="24">
    <Border x:Name="GuideCard"
            Style="{StaticResource SettingsSectionCardStyle}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="30">
      <Grid RowDefinitions="Auto,*,Auto"
            RowSpacing="20">
        <StackPanel Grid.Row="0" Spacing="7">
          <Grid x:Name="StepTrailGrid"
                ColumnDefinitions="*,*,*,*,*,*,*"
                ColumnSpacing="8">
            <TextBlock x:Name="StepLabel0" Grid.Column="0" Style="{StaticResource MetadataText}" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="StepLabel1" Grid.Column="1" Style="{StaticResource MetadataText}" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="StepLabel2" Grid.Column="2" Style="{StaticResource MetadataText}" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="StepLabel3" Grid.Column="3" Style="{StaticResource MetadataText}" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="StepLabel4" Grid.Column="4" Style="{StaticResource MetadataText}" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="StepLabel5" Grid.Column="5" Style="{StaticResource MetadataText}" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="StepLabel6" Grid.Column="6" Style="{StaticResource MetadataText}" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
          </Grid>
          <ProgressBar x:Name="StepProgress" Minimum="0" Maximum="7" Height="3" />
          <TextBlock x:Name="GuideTitle" Margin="0,6,0,0" Style="{StaticResource PageTitleText}" TextWrapping="Wrap" />
          <TextBlock x:Name="GuideBody" MaxWidth="880" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer x:Name="GuideScrollViewer"
                      Grid.Row="1"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollMode="Auto"
                      VerticalScrollBarVisibility="Auto">
          <Grid>
            <StackPanel x:Name="WelcomeStep" Spacing="20">
              <StackPanel HorizontalAlignment="Center" Spacing="8">
                <Image Source="ms-appx:///Assets/AboutLogo.png" Width="112" Height="112" Stretch="Uniform" />
                <TextBlock x:Name="WelcomeVersionText" HorizontalAlignment="Center" Style="{StaticResource SectionTitleText}" />
              </StackPanel>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <Border Style="{StaticResource SettingsInnerCardStyle}" Padding="18">
                  <StackPanel Spacing="8">
                    <FontIcon Glyph="&#xE8B7;" FontSize="24" HorizontalAlignment="Left" />
                    <TextBlock x:Name="WelcomeLibraryTitle" Style="{StaticResource SettingsRowLabelStyle}" />
                    <TextBlock x:Name="WelcomeLibraryBody" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource SettingsInnerCardStyle}" Padding="18">
                  <StackPanel Spacing="8">
                    <FontIcon Glyph="&#xE768;" FontSize="24" HorizontalAlignment="Left" />
                    <TextBlock x:Name="WelcomePlayerTitle" Style="{StaticResource SettingsRowLabelStyle}" />
                    <TextBlock x:Name="WelcomePlayerBody" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource SettingsInnerCardStyle}" Padding="18">
                  <StackPanel Spacing="8">
                    <FontIcon Glyph="&#xE774;" FontSize="24" HorizontalAlignment="Left" />
                    <TextBlock x:Name="WelcomeOnlineTitle" Style="{StaticResource SettingsRowLabelStyle}" />
                    <TextBlock x:Name="WelcomeOnlineBody" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>

            <views:FirstRunWebDavRestoreView x:Name="RestoreStep"
                                            Visibility="Collapsed"
                                            BusyChanged="OnRestoreBusyChanged" />

            <StackPanel x:Name="SourcesStep" Visibility="Collapsed" Spacing="10">
              <Border Style="{StaticResource SettingsInnerCardStyle}">
                <ContentControl x:Name="SourceSetupHost" Height="430" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
              </Border>
            </StackPanel>

            <StackPanel x:Name="TmdbStep" Visibility="Collapsed" Spacing="16">
              <Border Style="{StaticResource SettingsInnerCardStyle}" Padding="18">
                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="20" RowSpacing="12">
                  <StackPanel Grid.RowSpan="3" Spacing="5" VerticalAlignment="Center">
                    <TextBlock x:Name="TmdbCardTitle" Style="{StaticResource SettingsRowLabelStyle}" />
                    <TextBlock x:Name="TmdbCardBody" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" MaxWidth="520" />
                    <TextBlock x:Name="TmdbStatusText" Margin="0,5,0,0" Style="{StaticResource MetadataText}" TextWrapping="Wrap" />
                  </StackPanel>
                  <PasswordBox x:Name="TmdbTokenBox" Grid.Column="1" Width="320" MinWidth="240" PasswordRevealMode="Hidden" />
                  <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                    <Button x:Name="TmdbGetTokenButton" Click="OnGetTmdbToken" />
                    <Button x:Name="TmdbConfigureButton" Click="OnConfigureTmdb" />
                  </StackPanel>
                  <ProgressRing x:Name="TmdbProgressRing" Grid.Row="2" Grid.Column="1" Width="22" Height="22" HorizontalAlignment="Right" IsActive="False" Visibility="Collapsed" />
                </Grid>
              </Border>
              <InfoBar x:Name="TmdbInfoBar" IsOpen="True" Severity="Informational" IsClosable="False" />
            </StackPanel>

            <StackPanel x:Name="BangumiStep" Visibility="Collapsed" Spacing="16">
              <Border Style="{StaticResource SettingsInnerCardStyle}" Padding="18">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                  <StackPanel Spacing="5" VerticalAlignment="Center" HorizontalAlignment="Stretch">
                    <TextBlock x:Name="BangumiCardTitle" Style="{StaticResource SettingsRowLabelStyle}" HorizontalAlignment="Left" TextAlignment="Left" />
                    <TextBlock x:Name="BangumiCardBody" Style="{StaticResource SettingsDescriptionStyle}" HorizontalAlignment="Left" TextAlignment="Left" Margin="0" TextWrapping="Wrap" MaxWidth="610" />
                    <TextBlock x:Name="BangumiStatusText" Margin="0,5,0,0" Style="{StaticResource MetadataText}" HorizontalAlignment="Left" TextAlignment="Left" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button x:Name="BangumiLoginButton" Grid.Column="1" VerticalAlignment="Center" Click="OnBangumiLogin" />
                </Grid>
              </Border>
              <InfoBar x:Name="BangumiInfoBar" IsOpen="True" Severity="Informational" IsClosable="False" />
            </StackPanel>

            <StackPanel x:Name="PlaybackStep" Visibility="Collapsed" Spacing="12">
              <Border Style="{StaticResource SettingsInnerCardStyle}">
                <StackPanel>
                  <Grid Padding="16" ColumnDefinitions="*,Auto" ColumnSpacing="20">
                    <StackPanel VerticalAlignment="Center" Spacing="3">
                      <TextBlock x:Name="AudioLanguageTitle" Style="{StaticResource SettingsRowLabelStyle}" />
                      <TextBlock x:Name="AudioLanguageBody" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox x:Name="AudioLanguageCombo" Grid.Column="1" Width="220" SelectionChanged="OnPlaybackPreferenceChanged" />
                  </Grid>
                  <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                  <Grid Padding="16" ColumnDefinitions="*,Auto" ColumnSpacing="20">
                    <StackPanel VerticalAlignment="Center" Spacing="3">
                      <TextBlock x:Name="PrimarySubtitleTitle" Style="{StaticResource SettingsRowLabelStyle}" />
                      <TextBlock x:Name="PrimarySubtitleBody" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox x:Name="PrimarySubtitleCombo" Grid.Column="1" Width="220" SelectionChanged="OnPlaybackPreferenceChanged" />
                  </Grid>
                  <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                  <Grid Padding="16" ColumnDefinitions="*,Auto" ColumnSpacing="20">
                    <StackPanel VerticalAlignment="Center" Spacing="3">
                      <TextBlock x:Name="SecondarySubtitleTitle" Style="{StaticResource SettingsRowLabelStyle}" />
                      <TextBlock x:Name="SecondarySubtitleBody" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox x:Name="SecondarySubtitleCombo" Grid.Column="1" Width="220" SelectionChanged="OnPlaybackPreferenceChanged" />
                  </Grid>
                  <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                  <Grid Padding="16" ColumnDefinitions="*,Auto" ColumnSpacing="20">
                    <StackPanel VerticalAlignment="Center" Spacing="3">
                      <TextBlock x:Name="ControlsTimeoutTitle" Style="{StaticResource SettingsRowLabelStyle}" />
                      <TextBlock x:Name="ControlsTimeoutBody" Style="{StaticResource SettingsDescriptionStyle}" TextWrapping="Wrap" />
                    </StackPanel>
                    <ComboBox x:Name="ControlsTimeoutCombo" Grid.Column="1" Width="220" SelectionChanged="OnPlaybackPreferenceChanged" />
                  </Grid>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel x:Name="CompleteStep" Visibility="Collapsed" Spacing="14">
              <Border Style="{StaticResource SettingsInnerCardStyle}" Padding="18">
                <StackPanel Spacing="12">
                  <TextBlock x:Name="CompleteSummaryTitle" Style="{StaticResource SectionTitleText}" />
                  <TextBlock x:Name="CompleteMediaSummary" TextWrapping="Wrap" />
                  <TextBlock x:Name="CompleteTmdbSummary" TextWrapping="Wrap" />
                  <TextBlock x:Name="CompleteBangumiSummary" TextWrapping="Wrap" />
                  <TextBlock x:Name="CompletePlaybackSummary" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
              <CheckBox x:Name="ScanAfterFinishCheckBox" IsChecked="True" />
            </StackPanel>
          </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <Button x:Name="SkipButton" Grid.Column="0" HorizontalAlignment="Left" Click="OnSkip" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button x:Name="BackButton" Click="OnBack" />
            <Button x:Name="NextButton" Click="OnNext" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
