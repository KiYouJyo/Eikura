<UserControl x:Class="Eizo.Views.BangumiPublicView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer x:Name="PageScrollViewer"
                VerticalScrollMode="Auto"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                ViewChanged="PageScrollViewer_ViewChanged">
    <Grid Padding="24,16,24,32"
          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
          HorizontalAlignment="Stretch"
          UseLayoutRounding="True">
      <Grid ColumnDefinitions="*,Auto"
            ColumnSpacing="12">
        <StackPanel Spacing="4">
          <TextBlock x:Name="PageTitle"
                     Style="{StaticResource PageTitleText}" />
          <TextBlock x:Name="PageSubtitle"
                     Style="{StaticResource MetadataText}"
                     TextWrapping="Wrap" />
        </StackPanel>

        <Button x:Name="RefreshButton"
                Grid.Column="1"
                MinWidth="96"
                Height="36"
                Click="RefreshButton_Click">
          <StackPanel Orientation="Horizontal"
                      Spacing="6">
            <FontIcon Glyph="&#xE72C;"
                      FontSize="12" />
            <TextBlock x:Name="RefreshButtonText" />
          </StackPanel>
        </Button>
      </Grid>

      <Grid Grid.Row="1"
            Margin="0,14,0,0"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="10">
        <ListView x:Name="DayList"
                  Visibility="Collapsed"
                  SelectedIndex="0"
                  IsItemClickEnabled="True"
                  SelectionMode="Single"
                  SelectionChanged="DayList_SelectionChanged"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.HorizontalScrollMode="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                  ScrollViewer.VerticalScrollMode="Disabled">
          <ListView.ItemsPanel>
            <ItemsPanelTemplate>
              <ItemsStackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListView.ItemsPanel>
          <ListView.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Label}"
                         Margin="9,2"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="SeasonControls"
                    Visibility="Collapsed"
                    Orientation="Horizontal"
                    Spacing="8">
          <Button x:Name="PreviousSeasonButton"
                  Width="36"
                  Height="34"
                  Click="PreviousSeasonButton_Click">
            <FontIcon Glyph="&#xE76B;"
                      FontSize="12" />
          </Button>
          <Button x:Name="SeasonPickerButton"
                  MinWidth="156"
                  Height="34"
                  Padding="14,0"
                  HorizontalContentAlignment="Stretch"
                  Click="SeasonPickerButton_Click">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">
              <TextBlock x:Name="SelectedSeasonText"
                         VerticalAlignment="Center"
                         HorizontalAlignment="Center"
                         FontWeight="SemiBold" />
              <FontIcon Grid.Column="1"
                        Glyph="&#xE70D;"
                        FontSize="10"
                        VerticalAlignment="Center"
                        Opacity="0.7" />
            </Grid>
          </Button>
          <Button x:Name="NextSeasonButton"
                  Width="36"
                  Height="34"
                  Click="NextSeasonButton_Click">
            <FontIcon Glyph="&#xE76C;"
                      FontSize="12" />
          </Button>
          <Button x:Name="CurrentSeasonButton"
                  Height="34"
                  Click="CurrentSeasonButton_Click" />
        </StackPanel>

        <StackPanel x:Name="DiscoverControls"
                    Visibility="Collapsed"
                    Orientation="Horizontal"
                    Spacing="8">
          <ComboBox x:Name="DiscoverScopeCombo"
                    Width="196"
                    Height="34"
                    SelectedIndex="0"
                    SelectionChanged="DiscoverScopeCombo_SelectionChanged" />
        </StackPanel>

        <ProgressRing x:Name="LoadingRing"
                      Grid.Column="1"
                      Width="22"
                      Height="22"
                      IsActive="False"
                      Visibility="Collapsed"
                      VerticalAlignment="Center" />
      </Grid>

      <TextBlock x:Name="StatusText"
                 Grid.Row="2"
                 Margin="0,10,0,0"
                 Style="{StaticResource MetadataText}"
                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                 TextWrapping="Wrap" />

      <GridView x:Name="ResultsList"
                Grid.Row="3"
                Margin="0,12,0,0"
                SelectionMode="None"
                IsItemClickEnabled="True"
                ItemClick="ResultsList_ItemClick"
                ScrollViewer.VerticalScrollMode="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled"
                ScrollViewer.HorizontalScrollMode="Disabled"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <GridView.ItemsPanel>
          <ItemsPanelTemplate>
            <ItemsWrapGrid Orientation="Horizontal"
                           ItemWidth="204"
                           ItemHeight="408" />
          </ItemsPanelTemplate>
        </GridView.ItemsPanel>

        <GridView.ItemContainerStyle>
          <Style TargetType="GridViewItem">
            <Setter Property="Width" Value="192" />
            <Setter Property="Height" Value="396" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="GridViewItem">
                  <Grid x:Name="InteractionRoot">
                    <VisualStateManager.VisualStateGroups>
                      <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="PointerOver">
                          <VisualState.Setters>
                            <Setter Target="InteractionOverlay.Background"
                                    Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                          </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                          <VisualState.Setters>
                            <Setter Target="InteractionOverlay.Background"
                                    Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                          </VisualState.Setters>
                        </VisualState>
                      </VisualStateGroup>
                    </VisualStateManager.VisualStateGroups>

                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="Stretch"
                                      VerticalContentAlignment="Stretch" />

                    <Border x:Name="InteractionOverlay"
                            CornerRadius="12"
                            Background="Transparent"
                            IsHitTestVisible="False" />
                  </Grid>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </GridView.ItemContainerStyle>

        <GridView.ItemTemplate>
          <DataTemplate>
            <Border CornerRadius="12"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
              <Grid RowDefinitions="272,124">
                <Border CornerRadius="11,11,0,0"
                        Background="{ThemeResource EizoSelectionBrush}">
                  <Grid>
                    <FontIcon Glyph="&#xE8B2;"
                              FontSize="48"
                              Opacity="0.18"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                    <Image Source="{Binding Artwork}"
                           Stretch="UniformToFill" />
                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="8"
                            Padding="7,3"
                            CornerRadius="10"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                      <TextBlock Text="{Binding TypeLabel}"
                                 FontSize="11"
                                 FontWeight="SemiBold" />
                    </Border>
                  </Grid>
                </Border>

                <StackPanel Grid.Row="1"
                            Padding="12,9"
                            Spacing="4">
                  <TextBlock Text="{Binding Title}"
                             FontSize="13"
                             FontWeight="SemiBold"
                             MaxLines="2"
                             TextWrapping="WrapWholeWords"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Subtitle}"
                             FontSize="11"
                             Opacity="0.62"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding MetaLine}"
                             FontSize="11"
                             Opacity="0.78"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding SourceLabel}"
                             FontSize="10.5"
                             Opacity="0.58"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </GridView.ItemTemplate>
      </GridView>

      <Grid Grid.Row="4"
            Visibility="{Binding Visibility, ElementName=DiscoverControls}">
        <StackPanel Margin="0,8,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Visibility="{Binding Visibility, ElementName=LoadingRing}">
          <ProgressRing Width="18"
                        Height="18"
                        IsActive="{Binding IsActive, ElementName=LoadingRing}" />
          <TextBlock Text="{Binding Text, ElementName=StatusText}"
                     VerticalAlignment="Center"
                     Style="{StaticResource MetadataText}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </Grid>

      <!-- Internal has-more sentinel retained for compatibility with the existing
           discovery paging service. It has no visual footprint or interaction. -->
      <Grid Grid.Row="5"
            Height="0"
            MinHeight="0"
            IsHitTestVisible="False"
            Opacity="0">
        <Button x:Name="LoadMoreButton"
                Height="0"
                MinHeight="0"
                MinWidth="0"
                Padding="0"
                Margin="0"
                Visibility="Collapsed"
                Click="LoadMoreButton_Click" />
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
