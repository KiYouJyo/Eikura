<UserControl x:Class="Eizo.Views.BangumiAnimeIndexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Eizo.Controls">
  <ScrollViewer x:Name="PageScrollViewer"
                VerticalScrollMode="Auto"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollMode="Disabled"
                HorizontalScrollBarVisibility="Disabled"
                ViewChanged="PageScrollViewer_ViewChanged">
    <Grid Padding="24,16,24,32"
          RowDefinitions="Auto,Auto,Auto,Auto"
          HorizontalAlignment="Stretch"
          UseLayoutRounding="True">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="4">
          <TextBlock x:Name="PageTitle" Style="{StaticResource PageTitleText}" />
          <TextBlock x:Name="PageSubtitle" Style="{StaticResource MetadataText}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <ProgressRing x:Name="LoadingRing" Width="22" Height="22" IsActive="False" Visibility="Collapsed" />
          <Button x:Name="RefreshButton" MinWidth="96" Height="36" Click="RefreshButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <FontIcon Glyph="&#xE72C;" FontSize="12" />
              <TextBlock x:Name="RefreshButtonText" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="0,14,0,0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <AutoSuggestBox x:Name="SearchBox" Height="38" QueryIcon="Find" QuerySubmitted="SearchBox_QuerySubmitted" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button x:Name="SearchButton" Height="38" MinWidth="92" Click="SearchButton_Click">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <SymbolIcon Symbol="Find" />
              <TextBlock x:Name="SearchButtonText" />
            </StackPanel>
          </Button>
          <Button x:Name="ResetButton" Height="38" MinWidth="104" Click="ResetButton_Click" />
          <ComboBox x:Name="SortCombo" Width="180" Height="38" SelectedIndex="0" SelectionChanged="SortCombo_SelectionChanged" />
        </StackPanel>
      </Grid>

      <Expander x:Name="FilterExpander" Grid.Row="2" Margin="0,12,0,0" IsExpanded="True">
        <Expander.Header>
          <TextBlock x:Name="FilterTitle" Style="{StaticResource CardTitleText}" />
        </Expander.Header>
        <Border Padding="14,10" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <StackPanel Spacing="4">
            <Grid ColumnDefinitions="72,*">
              <TextBlock x:Name="FormatFilterLabel" Margin="4,10,8,0" Style="{StaticResource CardTitleText}" />
              <RadioButtons x:Name="FormatFilter" Grid.Column="1" MaxColumns="8" SelectedIndex="0" SelectionChanged="Filter_SelectionChanged" />
            </Grid>
            <Grid ColumnDefinitions="72,*">
              <TextBlock x:Name="SourceFilterLabel" Margin="4,10,8,0" Style="{StaticResource CardTitleText}" />
              <RadioButtons x:Name="SourceFilter" Grid.Column="1" MaxColumns="8" SelectedIndex="0" SelectionChanged="Filter_SelectionChanged" />
            </Grid>
            <Grid ColumnDefinitions="72,*">
              <TextBlock x:Name="GenreFilterLabel" Margin="4,10,8,0" Style="{StaticResource CardTitleText}" />
              <RadioButtons x:Name="GenreFilter" Grid.Column="1" MaxColumns="12" SelectedIndex="0" SelectionChanged="Filter_SelectionChanged" />
            </Grid>
            <Grid ColumnDefinitions="72,*">
              <TextBlock x:Name="RegionFilterLabel" Margin="4,10,8,0" Style="{StaticResource CardTitleText}" />
              <RadioButtons x:Name="RegionFilter" Grid.Column="1" MaxColumns="10" SelectedIndex="0" SelectionChanged="Filter_SelectionChanged" />
            </Grid>
            <Grid ColumnDefinitions="72,*">
              <TextBlock x:Name="AudienceFilterLabel" Margin="4,10,8,0" Style="{StaticResource CardTitleText}" />
              <RadioButtons x:Name="AudienceFilter" Grid.Column="1" MaxColumns="8" SelectedIndex="0" SelectionChanged="Filter_SelectionChanged" />
            </Grid>
            <Grid ColumnDefinitions="72,*">
              <TextBlock x:Name="YearFilterLabel" Margin="4,10,8,0" Style="{StaticResource CardTitleText}" />
              <RadioButtons x:Name="YearFilter" Grid.Column="1" MaxColumns="10" SelectedIndex="0" SelectionChanged="Filter_SelectionChanged" />
            </Grid>
          </StackPanel>
        </Border>
      </Expander>

      <Grid Grid.Row="3" Margin="0,12,0,0" RowDefinitions="Auto,Auto,Auto">
        <TextBlock x:Name="StatusText" Style="{StaticResource MetadataText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        <GridView x:Name="ResultsList"
                  Grid.Row="1"
                  Margin="0,10,0,0"
                  ItemsPanel="{StaticResource PosterCardItemsPanelTemplate}"
                  ItemContainerStyle="{StaticResource PosterCardGridViewItemStyle}"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="ResultsList_ItemClick"
                  ScrollViewer.VerticalScrollMode="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Disabled"
                  ScrollViewer.HorizontalScrollMode="Disabled"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <GridView.ItemTemplate>
            <DataTemplate>
              <controls:MediaPosterCard Artwork="{Binding Artwork}"
                                        IconGlyph="&#xE8B2;"
                                        BadgeText="{Binding TypeLabel}"
                                        Title="{Binding Title}"
                                        Subtitle="{Binding Subtitle}"
                                        MetaLine="{Binding MetaLine}"
                                        FooterLine="{Binding SourceLabel}" />
            </DataTemplate>
          </GridView.ItemTemplate>
        </GridView>
        <StackPanel Grid.Row="2"
                    Margin="0,8,0,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="8"
                    Visibility="{Binding Visibility, ElementName=LoadingRing}">
          <ProgressRing Width="18" Height="18" IsActive="{Binding IsActive, ElementName=LoadingRing}" />
          <TextBlock Text="{Binding Text, ElementName=StatusText}"
                     VerticalAlignment="Center"
                     Style="{StaticResource MetadataText}"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
      </Grid>
    </Grid>
  </ScrollViewer>
</UserControl>
