<Window x:Class="Eizo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Eizo.Views">
  <Window.SystemBackdrop>
    <MicaBackdrop />
  </Window.SystemBackdrop>

  <Grid x:Name="WindowRoot"
        Background="Transparent"
        PreviewKeyDown="WindowRoot_PreviewKeyDown"
        Loaded="OnStartupWindowRootLoaded">
    <Grid x:Name="MainContent"
          Opacity="0"
          IsHitTestVisible="False">
      <Grid x:Name="RootGrid"
            Background="Transparent"
            RowDefinitions="48,*"
            SizeChanged="RootGrid_SizeChanged"
            Loaded="OnStartupMainContentLoaded"
            UseLayoutRounding="True">
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Background="Transparent"
              ColumnDefinitions="128,*,132"
              Padding="0,0,12,0">
          <TextBlock Text="Eikura"
                     Style="{StaticResource BodyText}"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />

          <ScrollViewer Grid.Column="1"
                        Height="32"
                        Margin="0,8,12,8"
                        HorizontalScrollMode="Auto"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollMode="Disabled"
                        VerticalScrollBarVisibility="Disabled"
                        IsTabStop="False">
            <StackPanel x:Name="ShellTabs"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Top">
              <StackPanel x:Name="ShellTabItems"
                          Orientation="Horizontal"
                          Spacing="8" />
              <Button x:Name="ShellNewTabButton"
                      Width="32"
                      Height="32"
                      MinWidth="32"
                      Padding="0"
                      Background="Transparent"
                      BorderThickness="0"
                      CornerRadius="7"
                      HorizontalContentAlignment="Center"
                      VerticalContentAlignment="Center"
                      Click="ShellNewTabButton_Click">
                <TextBlock Text="+"
                           FontSize="17"
                           Opacity="0.68" />
              </Button>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <NavigationView x:Name="ShellNavigation"
                        Grid.Row="1"
                        Background="Transparent"
                        AlwaysShowHeader="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        Loaded="ShellNavigation_Loaded"
                        ItemInvoked="ShellNavigation_ItemInvoked">
          <NavigationView.Resources>
            <Thickness x:Key="NavigationViewBorderThickness">0</Thickness>
            <Thickness x:Key="NavigationViewPaneContentGridMargin">0</Thickness>
            <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
            <Thickness x:Key="NavigationViewMinimalContentGridBorderThickness">0</Thickness>
          </NavigationView.Resources>

          <NavigationView.MenuItems>
            <NavigationViewItem x:Name="HomeNav" Tag="home" IsSelected="True">
              <NavigationViewItem.Icon><SymbolIcon Symbol="Home" /></NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItem x:Name="BangumiNav"
                                Tag="bangumi-following"
                                SelectsOnInvoked="True"
                                IsExpanded="True">
              <NavigationViewItem.Icon><FontIcon Glyph="&#xE774;" /></NavigationViewItem.Icon>
              <NavigationViewItem.MenuItems>
                <NavigationViewItem x:Name="AnimeIndexNav" Tag="bangumi-anime-index">
                  <NavigationViewItem.Icon><SymbolIcon Symbol="Find" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="DiscoverNav" Tag="bangumi-discover">
                  <NavigationViewItem.Icon><FontIcon Glyph="&#xE734;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="CalendarNav" Tag="bangumi-calendar">
                  <NavigationViewItem.Icon><FontIcon Glyph="&#xE787;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SeasonalNav" Tag="bangumi-seasonal">
                  <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B2;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
              </NavigationViewItem.MenuItems>
            </NavigationViewItem>

            <NavigationViewItem x:Name="CategoryNav"
                                Tag="categories"
                                SelectsOnInvoked="True"
                                IsExpanded="True">
              <NavigationViewItem.Icon><SymbolIcon Symbol="Library" /></NavigationViewItem.Icon>
              <NavigationViewItem.MenuItems>
                <NavigationViewItem x:Name="AnimeNav" Tag="anime">
                  <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B2;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="MoviesNav" Tag="movies">
                  <NavigationViewItem.Icon><FontIcon Glyph="&#xE714;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SeriesNav" Tag="series">
                  <NavigationViewItem.Icon><FontIcon Glyph="&#xE8FD;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SourcesNav" Tag="sources">
                  <NavigationViewItem.Icon><FontIcon Glyph="&#xE753;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
              </NavigationViewItem.MenuItems>
            </NavigationViewItem>
          </NavigationView.MenuItems>

          <NavigationView.FooterMenuItems>
            <NavigationViewItem x:Name="CacheNav" Tag="cache">
              <NavigationViewItem.Icon><FontIcon Glyph="&#xE7C5;" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="AboutNav" Tag="about">
              <NavigationViewItem.Icon><SymbolIcon Symbol="Help" /></NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem x:Name="SettingsNav" Tag="settings">
              <NavigationViewItem.Icon><SymbolIcon Symbol="Setting" /></NavigationViewItem.Icon>
            </NavigationViewItem>
          </NavigationView.FooterMenuItems>

          <Grid x:Name="MainContentHost"
                Background="Transparent"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch" />
        </NavigationView>
      </Grid>
    </Grid>

    <views:FirstRunGuideHost x:Name="FirstRunGuideHost"
                             Visibility="Collapsed"
                             Canvas.ZIndex="90" />

    <Grid x:Name="StartupOverlay"
          Background="Transparent"
          Canvas.ZIndex="100">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="18">
        <Image x:Name="StartupLogo"
               Source="ms-appx:///Assets/AboutLogo.png"
               Width="183"
               Height="183"
               Stretch="Uniform"
               HorizontalAlignment="Center"
               ImageOpened="OnStartupLogoImageOpened"
               ImageFailed="OnStartupLogoImageFailed" />
        <ProgressBar x:Name="StartupProgressBar"
                     Width="72"
                     Height="2"
                     IsIndeterminate="True"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     Background="Transparent"
                     HorizontalAlignment="Center" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
