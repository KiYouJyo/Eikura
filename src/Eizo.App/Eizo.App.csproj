<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Eizo</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <DefaultLanguage>zh-CN</DefaultLanguage>
    <AppxBundleAutoResourcePackageQualifiers>Scale|DXFeatureLevel</AppxBundleAutoResourcePackageQualifiers>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <Version>1.3.1</Version>
    <AssemblyVersion>1.3.1.0</AssemblyVersion>
    <FileVersion>1.3.1.0</FileVersion>
    <InformationalVersion>1.3.1</InformationalVersion>
    <ApplicationIcon>Assets\Eizo.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- Keep every supplied MSIX qualifier asset in the package layout.  The manifest
         selects the resource groups; retaining the full set prevents a build host's
         active DPI from silently dropping the other Windows scale/theme variants. -->
    <None Update="Assets\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260710003" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.0" />
    <PackageReference Include="Eizo.Playback.LibVLC.WinUI" Version="0.2.3" Condition="'$(EizoPlaybackUseSource)' != 'true'" />
    <ProjectReference Include="../../.deps/Eizo.Playback/src/Eizo.Playback.LibVLC.WinUI/Eizo.Playback.LibVLC.WinUI.csproj" Condition="'$(EizoPlaybackUseSource)' == 'true'" />
    <ProjectReference Include="../Eizo.Media/Eizo.Media.csproj" />
    <ProjectReference Include="../Eizo.RecognitionIntegration/Eizo.RecognitionIntegration.csproj" />
    <ProjectReference Include="../Eizo.MetadataIntegration/Eizo.MetadataIntegration.csproj" />
    <ProjectReference Include="../Eizo.Cache/Eizo.Cache.csproj" />
    <ProjectReference Include="../Eizo.Bangumi/Eizo.Bangumi.csproj" />
    <!-- The final Windows host owns the native LibVLC runtime deployment.
         Playback runtime updates replace only Eizo.Playback managed assemblies;
         VideoLAN native compatibility remains governed by the host contract. -->
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
  </ItemGroup>

  <!--
    Playback and Metadata are independently updateable from Eizo 0.3.6 onward.
    In Release builds their bundled runtime implementations must not remain beside Eizo.exe:
    the default .deps.json probing path would win before AssemblyLoadContext.Resolving
    and silently bind the old bundled implementation after a component update.

    Keep an explicit fallback copy under Components/Bundled. ComponentEarlyBootstrap
    selects either the validated external version in %LOCALAPPDATA%\Eizo\Components
    or this bundled fallback before WinUI generated XAML metadata resolves PlaybackView.
  -->
  <Target Name="RelocateBundledUpdateableComponents"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <_PlaybackComponentAssembly Include="$(OutDir)Eizo.Playback.Abstractions.dll" />
      <_PlaybackComponentAssembly Include="$(OutDir)Eizo.Playback.Core.dll" />
      <_PlaybackComponentAssembly Include="$(OutDir)Eizo.Playback.LibVLC.dll" />
      <_PlaybackComponentAssembly Include="$(OutDir)Eizo.Playback.LibVLC.WinUI.dll" />
      <_RecognitionComponentAssembly Include="$(OutDir)Eizo.Metadata.Recognition.dll" />
      <_RecognitionComponentAssembly Include="$(OutDir)Eizo.Metadata.Core.dll" />
      <_RecognitionComponentAssembly Include="$(OutDir)Eizo.Metadata.Providers.dll" />
    </ItemGroup>

    <Error Condition="!Exists('%(_PlaybackComponentAssembly.Identity)')"
           Text="Playback runtime assembly is missing before relocation: %(_PlaybackComponentAssembly.Identity)" />
    <Error Condition="!Exists('%(_RecognitionComponentAssembly.Identity)')"
           Text="Recognition runtime assembly is missing before relocation: %(_RecognitionComponentAssembly.Identity)" />

    <MakeDir Directories="$(OutDir)Components\Bundled\Playback" />
    <MakeDir Directories="$(OutDir)Components\Bundled\Recognition" />
    <Copy SourceFiles="@(_PlaybackComponentAssembly)"
          DestinationFolder="$(OutDir)Components\Bundled\Playback"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_RecognitionComponentAssembly)"
          DestinationFolder="$(OutDir)Components\Bundled\Recognition"
          SkipUnchangedFiles="true" />
    <Delete Files="@(_PlaybackComponentAssembly)" />
    <Delete Files="@(_RecognitionComponentAssembly)" />
    <Message Importance="high"
             Text="Relocated bundled Playback and Metadata implementations for independent runtime resolution." />
  </Target>

  <!-- MSIX packaging reconstructs PackageLayout from resolved package/project inputs after
       CopyFilesToOutputDirectory. Relocate the updateable managed runtimes at that boundary too,
       otherwise the root probing path shadows a validated external component. -->
  <Target Name="RelocatePackagedUpdateableComponents"
          AfterTargets="_CreatePackageLayout"
          BeforeTargets="_CreateMainPackageFileMap"
          Condition="'$(Configuration)' == 'Release' and Exists('$(IntermediateOutputPath)PackageLayout')">
    <PropertyGroup>
      <_EizoPackageLayoutRoot>$(IntermediateOutputPath)PackageLayout</_EizoPackageLayoutRoot>
    </PropertyGroup>
    <ItemGroup>
      <_PackagedPlaybackComponentAssembly Include="$(_EizoPackageLayoutRoot)\Eizo.Playback.Abstractions.dll" />
      <_PackagedPlaybackComponentAssembly Include="$(_EizoPackageLayoutRoot)\Eizo.Playback.Core.dll" />
      <_PackagedPlaybackComponentAssembly Include="$(_EizoPackageLayoutRoot)\Eizo.Playback.LibVLC.dll" />
      <_PackagedPlaybackComponentAssembly Include="$(_EizoPackageLayoutRoot)\Eizo.Playback.LibVLC.WinUI.dll" />
      <_PackagedRecognitionComponentAssembly Include="$(_EizoPackageLayoutRoot)\Eizo.Metadata.Recognition.dll" />
      <_PackagedRecognitionComponentAssembly Include="$(_EizoPackageLayoutRoot)\Eizo.Metadata.Core.dll" />
      <_PackagedRecognitionComponentAssembly Include="$(_EizoPackageLayoutRoot)\Eizo.Metadata.Providers.dll" />
    </ItemGroup>

    <Error Condition="!Exists('%(_PackagedPlaybackComponentAssembly.Identity)')"
           Text="Playback runtime assembly is missing from PackageLayout before relocation: %(_PackagedPlaybackComponentAssembly.Identity)" />
    <Error Condition="!Exists('%(_PackagedRecognitionComponentAssembly.Identity)')"
           Text="Recognition runtime assembly is missing from PackageLayout before relocation: %(_PackagedRecognitionComponentAssembly.Identity)" />

    <MakeDir Directories="$(_EizoPackageLayoutRoot)\Components\Bundled\Playback" />
    <MakeDir Directories="$(_EizoPackageLayoutRoot)\Components\Bundled\Recognition" />
    <Copy SourceFiles="@(_PackagedPlaybackComponentAssembly)"
          DestinationFolder="$(_EizoPackageLayoutRoot)\Components\Bundled\Playback"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PackagedRecognitionComponentAssembly)"
          DestinationFolder="$(_EizoPackageLayoutRoot)\Components\Bundled\Recognition"
          SkipUnchangedFiles="true" />
    <Delete Files="@(_PackagedPlaybackComponentAssembly)" />
    <Delete Files="@(_PackagedRecognitionComponentAssembly)" />
    <Message Importance="high"
             Text="Relocated packaged Playback and Metadata runtimes out of the MSIX default probing root." />
  </Target>

</Project>
